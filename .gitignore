# Custom code scripts
**/PostProcessingCode/path.py
**/PostProcessingCode/test.py
**/CageServer/Code/Constants.py

# PlateformIO
**/.pio
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# documentation
# *.pdf

# Byte-compiled / optimized / DLL files
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.pyc

# C extensions
**/*.so

# MacOS stuff
**/*.DS_Store

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
# **/*.manifest
# **/*.spec

# Installer logs
**/pip-log.txt
**/pip-delete-this-directory.txt

# Unit test / coverage reports
**/htmlcov
**/.tox
**/.nox
**/.coverage
**/.coverage.*
**/.cache
**/nosetests.xml
**/coverage.xml
**/*.cover
**/*.py,cover
**/.hypothesis
**/.pytest_cache

# Jupyter Notebook
**/*.ipynb_checkpoints

# IPython
**/profile_default
**/ipython_config.py

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
**/__pypackages__
